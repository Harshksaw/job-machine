# Requires the Claude Code CLI (`claude`) installed and logged in (run `claude` once). No Anthropic API key needed.
RESUME_TAILOR_TOKEN=replace-with-a-long-random-string

# Dashboard API: Google Apps Script read endpoint for the application log.
# APPS_SCRIPT_URL is the deployed /exec URL; APPS_SCRIPT_READ_SECRET gates the
# read action. Read only by app/sheets.py; never returned to clients.
APPS_SCRIPT_URL=
APPS_SCRIPT_READ_SECRET=
