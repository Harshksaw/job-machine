((# Mirrors harshsaw.tex (the canonical resume) structurally, so a tailored
    PDF is the same document with different content selected -- same class,
    same preamble, same macros, same spacing. Keep this file and harshsaw.tex
    in step: if one changes shape, so must the other. #))
\documentclass{resume}
\usepackage[left=0.2in,top=0.15in,right=0.2in,bottom=0.15in]{geometry}
\usepackage{setspace}
\setstretch{0.55}
\renewcommand{\labelitemi}{$\bullet$}

\name{\normalsize (((contact.name)))}
\address{\footnotesize (((contact.phone))) \\ (((contact.location)))}
\address{\footnotesize
  \href{mailto:(((contact.email)))}{(((contact.email)))} \\
  \href{(((contact.linkedin_url)))}{LinkedIn} \\
  \href{(((contact.github_url)))}{GitHub} \\
  \href{(((contact.website_url)))}{(((contact.website_display)))}
}
\begin{document}

\vspace{-.5em}
\begin{rSection}{Summary}
{\scriptsize (((summary)))}
\end{rSection}\vspace{-0.6em}

\begin{rSection}{Education}
{\scriptsize \textbf{(((education.degree)))}, (((education.school))) \hfill (((education.date)))}
\end{rSection}\vspace{-0.2em}

\begin{rSection}{Experience}
\scriptsize
((* for job in jobs *))
\job{(((job.title)))}{(((job.company)))}{(((job.url)))}{(((job.location)))}{(((job.dates)))}
\begin{jobitems}
((* for bullet in job.bullets *))
    \item (((bullet)))
((* endfor *))
\end{jobitems}
((* endfor *))
\end{rSection}\vspace{-0.7em}

\begin{rSection}{Projects}
((* for project in projects *))
\scriptsize \textbf{(((project.name)))}
{\scriptsize \textit{(((project.tech)))}}
((* if project.demo_url or project.repo_url *))
\hfill
((* if project.demo_url *))\href{(((project.demo_url)))}{Live Demo}((* endif *))((* if project.demo_url and project.repo_url *)) | ((* endif *))((* if project.repo_url *))\href{(((project.repo_url)))}{GitHub}((* endif *))
((* endif *))

\begin{itemize}\itemsep -4pt
((* for bullet in project.bullets *))
    \item (((bullet)))
((* endfor *))
\end{itemize}
((* endfor *))
\end{rSection}\vspace{-0.7em}

\begin{rSection}{Technical Skills}
\scriptsize
\begin{itemize}[leftmargin=0em,label={},itemsep=0pt,topsep=1pt,parsep=0pt,partopsep=0pt]
((* for line in skills *))
\item \textbf{(((line.category))):} (((line.entries)))
((* endfor *))
\end{itemize}
\end{rSection}\vspace{-0.5em}

\begin{rSection}{Achievements}
\scriptsize
\begin{itemize}\itemsep -7pt
((* for bullet in achievements *))
    \item (((bullet)))
((* endfor *))
\end{itemize}
\end{rSection}

\end{document}
